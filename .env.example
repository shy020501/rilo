# Loaded server-side only. Never commit your .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=xhigh
OPENAI_MAX_OUTPUT_TOKENS=16384
# Optional OpenAI-compatible endpoint supporting Responses + vision + tool calling:
# OPENAI_BASE_URL=https://api.openai.com/v1

RILO_ENV=libero
RILO_POLICY=openai
LIBERO_SUITE=libero_90
RILO_TASK_ID=7
RILO_IMAGE_SIZE=512
RILO_API_TIMEOUT=240
RILO_PROMPT_FILE=prompts/control.md
RILO_DATA_DIR=artifacts/runs
RILO_HOST=127.0.0.1
RILO_PORT=8000

# Linux CPU offscreen rendering. Set egl for a working NVIDIA driver/GPU.
MUJOCO_GL=osmesa
# Optional existing LIBERO configuration directory:
# LIBERO_CONFIG_PATH=/absolute/path/to/config-directory
